// Cloudflare Workers static assets: `wrangler deploy` (GitHub Actions, .github/workflows/update.yml)
// uploads out/ as a Worker with no code. Default html_handling (auto-trailing-slash) matches
// next.config.ts `trailingSlash: true`.
{
  "name": "trligelo",
  "compatibility_date": "2026-11-01",
  // Cloudflare creates the DNS record and the certificate. workers.dev stays on as a fallback;
  // the pages' canonical links point search engines to trligelo.com.
  "routes": [{ "pattern": "trligelo.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
